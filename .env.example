# mock | real — mock은 MSW가 /graphql을 가로챈다. 백엔드가 준비되면 real.
VITE_API_MODE=mock
# real 모드의 백엔드 출처. 예: https://api.jandilog.example (끝에 / 없이)
VITE_API_ORIGIN=
# 목 기준 시각(선택). 기본 2026-10-01T10:00:00+09:00
VITE_MOCK_NOW=
# 목 응답 지연 ms(선택). 기본 250
VITE_MOCK_LATENCY=

# bridge: 지원하는 연산만 실서버로 (README "로컬 백엔드 연결")
# VITE_API_MODE=bridge
# VITE_BRIDGE_ORIGIN=http://localhost:8080
