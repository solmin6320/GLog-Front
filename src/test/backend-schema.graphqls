# 배포 백엔드 GraphQL 스키마 사본 (GLog-Backend origin/main 0a060a5의 src/main/resources/graphql/*.graphqls를 이어 붙임).
# 테스트용 가짜 백엔드(src/test/backend.ts)가 bridge 요청을 이 스키마로 검사한다 — 서버에 없는 필드를 쓰면 테스트가 실패한다.
# 백엔드 스키마가 바뀌면 다시 만든다: GLog-Backend에서 git show origin/main:<각 .graphqls> 를 이어 붙인다.

# 관리자 (기능명세서 9장). 웹 전용, 관리자 권한은 대메뉴 6개(대시보드 · 경고 복구·벌칙 · 가입 승인 · 면제 관리 · 공지 관리 · 게시물 관리) 안에서만.
# 가입 승인은 member-approval, 면제 관리는 exemption, 공지 관리는 notice 스키마에 있다

extend type Query {
    """
    판정 정정 재계산 미리보기 (대시보드 정정 패널, E-49 · E-50 · E-58). 계산만 하고 아무것도 바꾸지 않는다.
    정정할 수 없는 판정(보류, 같은 결과, 제외를 면제가 아닌 결과로)은 JUDGMENT_NOT_CORRECTABLE
    """
    previewJudgmentCorrection(judgmentId: ID!, status: AdminCorrectionStatus!): JudgmentCorrectionPreview!
}

extend type Mutation {
    """
    판정을 정정하고 경고를 다시 계산한다 (관리자). 결과는 통과·미달·면제 셋뿐이고 사유는 필수(1~500자).
    제외(첫 참가·팀 없음) 판정은 면제로만 정정한다. 이력과 관리자 행동 로그가 남는다.
    expectedStatus가 지금 판정과 다르면 JUDGMENT_CHANGED
    """
    correctJudgment(input: JudgmentCorrectionInput!): CorrectedJudgment!
}

"이름 · GitHub 아이디 (관리자 목록에 붙는 회원 표시)"
type AdminMemberBrief {
    id: ID!
    nickname: String!
    githubLogin: String!
}

enum AdminJudgmentStatus {
    PASS
    FAIL
    EXEMPT
    "첫 참가 주 · 팀 없음"
    EXCLUDED
    "GitHub 조회 실패로 아직 확정하지 못함"
    HOLD
}

"정정으로 만들 수 있는 결과 (Q-05)"
enum AdminCorrectionStatus {
    PASS
    FAIL
    EXEMPT
}

"""
정정 · 소급 면제 · 경고 복구의 재계산 영향.
onHold면 보류 중인 주가 있어 경고 수를 비교하지 않는다(null). recordOnly면 벌칙 이행 이전 주라 기록만 바뀌고 경고 수는 그대로다 (E-58 · E-59)
"""
type AdminRecalcImpact {
    onHold: Boolean!
    warningCountBefore: Int
    warningCountAfter: Int
    "벌칙 대상에 새로 들어간다 (E-42)"
    entersPenalty: Boolean!
    "벌칙 대상에서 빠진다 (E-50)"
    leavesPenalty: Boolean!
    recordOnly: Boolean!
    "그 주 이후 다시 계산되는 판정 수"
    affectedWeeks: Int!
}

input JudgmentCorrectionInput {
    judgmentId: ID!
    status: AdminCorrectionStatus!
    "필수, 1~500자"
    reason: String!
    "미리보기 때 본 현재 결과. 다르면 JUDGMENT_CHANGED"
    expectedStatus: AdminJudgmentStatus
}

type JudgmentCorrectionPreview {
    judgmentId: ID!
    member: AdminMemberBrief!
    weekStart: String!
    currentStatus: AdminJudgmentStatus!
    targetStatus: AdminJudgmentStatus!
    impact: AdminRecalcImpact!
}

"정정 반영 뒤의 판정과 그 회원의 경고 상태. warningCount는 보류 주가 남아 있으면 null"
type CorrectedJudgment {
    judgmentId: ID!
    member: AdminMemberBrief!
    weekStart: String!
    status: AdminJudgmentStatus!
    onHold: Boolean!
    warningCount: Int
    penaltyTarget: Boolean!
}

# ---- 대시보드 (AD-01 ⑤~⑨) ----

extend type Query {
    "처리 대기 요약 (AD-01 ⑤). 메뉴 배지도 같은 값을 쓴다"
    adminDashboardSummary: AdminDashboardSummary!
    """
    주차별 판정 결과 (AD-01 ⑥⑦⑧). weekStart를 생략하면 직전 주(이번 월요일 판정의 대상), 월요일이 아니면 INVALID_INPUT.
    keyword는 닉네임·GitHub 아이디 부분 일치(50자 이하). 집계는 검색·필터와 무관한 그 주 전체 값이고 팀 이름은 싣지 않는다
    """
    adminJudgments(
        weekStart: String
        keyword: String
        filter: AdminJudgmentFilter = ALL
        "이전 페이지의 nextCursor"
        after: String
    ): AdminJudgmentPage!
    "보류 목록 (AD-01 ⑨). 사람이 처리해야 하는 보류만 오래된 순 커서 기반 20개. totalCount가 0이면 보류 표시를 그리지 않는다"
    adminJudgmentHolds(
        "이전 페이지의 nextCursor"
        after: String
    ): AdminHoldPage!
}

extend type Mutation {
    "보류 한 건을 다시 판정한다 (관리자). 이미 확정된 건은 건너뛰고 현재 결과를 돌려준다. 판정 행이 없으면 NOT_FOUND"
    retryJudgmentHold(memberId: ID!, weekStart: String!): AdminHoldRetryResult!
    "사람이 처리해야 하는 보류 건만 모두 다시 판정한다 (관리자, E-35). 확정된 건은 건드리지 않는다"
    retryAllJudgmentHolds: AdminHoldRerunSummary!
}

enum AdminJudgmentFilter {
    ALL
    FAIL_ONLY
    HOLD_ONLY
}

"판정에서 빠진 이유. NO_TEAM · FIRST_WEEK은 제외, EXEMPTION_PERIOD · PERSONAL_EXEMPTION은 면제"
enum AdminSkipReason {
    NO_TEAM
    FIRST_WEEK
    EXEMPTION_PERIOD
    PERSONAL_EXEMPTION
}

"보류 이유. API_ERROR는 재시도로 풀리고 IDENTITY_MISMATCH는 본인이 다시 로그인해야 풀린다 (E-08)"
enum AdminHoldReason {
    API_ERROR
    IDENTITY_MISMATCH
}

type AdminDashboardSummary {
    "이번 주 미달이 세는 판정 주 월요일 (직전 주)"
    judgedWeekStart: String!
    pendingMembers: Int!
    "judgedWeekStart의 미달 판정 수"
    failedMembers: Int!
    penaltyTargets: Int!
    pendingExemptions: Int!
}

"판정 결과 한 행. warningCount는 보류 주가 남은 회원이면 null. manualHold는 사람이 처리해야 하는 보류"
type AdminJudgmentRow {
    judgmentId: ID!
    member: AdminMemberBrief!
    status: AdminJudgmentStatus!
    skipReason: AdminSkipReason
    holdReason: AdminHoldReason
    verifiedDays: Int
    recordCount: Int
    warningCount: Int
    corrected: Boolean!
    manualHold: Boolean!
}

"""
한 주의 집계와 회원별 결과. executedAt은 그 주 판정이 확정된 마지막 시각(KST, 없으면 null).
holdCount는 사람이 처리해야 하는 보류만 센다
"""
type AdminJudgmentPage {
    weekStart: String!
    weekEnd: String!
    executedAt: String
    passCount: Int!
    failCount: Int!
    exemptCount: Int!
    firstWeekCount: Int!
    holdCount: Int!
    items: [AdminJudgmentRow!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

type AdminHold {
    member: AdminMemberBrief!
    weekStart: String!
    reason: AdminHoldReason!
    retryCount: Int!
    "자동 재시도 3회를 다 썼는가"
    retriesExhausted: Boolean!
}

type AdminHoldPage {
    items: [AdminHold!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
    totalCount: Int!
    "그중 본인이 다시 로그인해야 풀리는 건수"
    identityMismatchCount: Int!
}

type AdminHoldRetryResult {
    member: AdminMemberBrief!
    weekStart: String!
    status: AdminJudgmentStatus!
    holdReason: AdminHoldReason
    "이번 재시도로 보류가 풀려 확정됐는가"
    resolved: Boolean!
}

type AdminHoldRerunSummary {
    attempted: Int!
    resolved: Int!
    stillHold: Int!
    failed: Int!
}

# ---- 경고 복구 · 벌칙 (AD-01 `warnings`, 기능명세서 6·9장) ----

extend type Query {
    "벌칙 대상 목록 (경고 3개 이상). 도달한 주가 오래된 순 커서 기반 20명. 이 화면에서만 비공개 팀도 실명으로 보인다"
    adminPenaltyTargets(
        "이전 페이지의 nextCursor"
        after: String
    ): AdminPenaltyTargetPage!
    """
    삭제 표시된 경고 목록 (추방 · 팀 삭제). 삭제가 최근인 순 커서 기반 20개.
    정정 · 소급 면제로 미달이 아니게 된 주의 경고는 나오지 않는다
    """
    adminDeletedWarnings(
        "이전 페이지의 nextCursor"
        after: String
    ): AdminDeletedWarningPage!
    """
    경고를 복구하면 바뀌는 수치 미리보기 (E-42 · E-43 · E-59). 계산만 하고 아무것도 바꾸지 않는다.
    삭제된 경고가 아니면 ALREADY_HANDLED, 복구 대상이 아니면 NOT_FOUND
    """
    previewWarningRestore(warningId: ID!): AdminWarningRestorePreview!
}

extend type Mutation {
    """
    벌칙 이행을 체크한다 (관리자). 경고 0 · 연속 통과 0이 되고 되돌릴 수 없는 고정점이 된다 (E-58).
    벌칙 대상이 아니면 NOT_PENALTY_TARGET. 관리자 행동 로그가 남는다
    """
    fulfillPenalty(memberId: ID!): AdminPenaltyFulfillment!
    """
    삭제된 경고를 복구한다 (관리자). 삭제 표시를 풀고 아직 있는 팀의 카테고리를 되살린 뒤 경고를 다시 계산한다.
    벌칙 이행 이전 주의 경고는 기록만 되살아난다 (E-59). 이미 복구됐으면 ALREADY_HANDLED. 관리자 행동 로그가 남는다
    """
    restoreWarning(warningId: ID!): AdminRestoredWarning!
}

"경고에 붙은 팀. 이 화면에서는 비공개 팀도 실명이다"
type AdminWarningTeam {
    id: ID!
    name: String!
}

type AdminPenaltyTarget {
    member: AdminMemberBrief!
    "3을 넘을 수 있다"
    warningCount: Int!
    "경고가 3개에 도달한 주 월요일"
    reachedWeek: String!
    teams: [AdminWarningTeam!]!
}

type AdminPenaltyTargetPage {
    items: [AdminPenaltyTarget!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
    totalCount: Int!
}

type AdminPenaltyFulfillment {
    member: AdminMemberBrief!
    "이행 체크 시각 (KST, ISO-8601)"
    fulfilledAt: String!
    reachedWeek: String!
}

enum AdminWarningDeleteReason {
    KICKED
    TEAM_DELETED
}

"restoreTeams는 복구하면 되살아나는 카테고리. teamDeleted면 그런 팀이 없어 '삭제된 팀'으로 표시된다 (E-43)"
type AdminDeletedWarning {
    warningId: ID!
    member: AdminMemberBrief!
    "경고를 받은 주 월요일"
    weekStart: String!
    deleteReason: AdminWarningDeleteReason!
    deletedAt: String!
    restoreTeams: [AdminWarningTeam!]!
    teamDeleted: Boolean!
}

type AdminDeletedWarningPage {
    items: [AdminDeletedWarning!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

"impact.entersPenalty면 '다시 벌칙 대상이 됩니다'(E-42), impact.recordOnly면 '기록만 되살립니다'(E-59), teamDeleted면 '삭제된 팀으로 표시됩니다'(E-43)"
type AdminWarningRestorePreview {
    warningId: ID!
    member: AdminMemberBrief!
    weekStart: String!
    restoreTeams: [AdminWarningTeam!]!
    teamDeleted: Boolean!
    impact: AdminRecalcImpact!
}

"복구를 반영한 뒤 그 회원의 경고 상태. warningCount는 보류 주가 남아 있으면 null"
type AdminRestoredWarning {
    warningId: ID!
    member: AdminMemberBrief!
    weekStart: String!
    onHold: Boolean!
    warningCount: Int
    penaltyTarget: Boolean!
}

# ---- 게시물 관리 (AD-01 `posts`, 기능명세서 3·9장) ----

extend type Query {
    """
    글 · 댓글 목록 (관리자). 삭제되지 않은 것을 최신순 커서 기반 20개로 한 줄에 섞어 보여준다.
    keyword는 제목 · 내용 · 작성자(닉네임 · GitHub 아이디) 부분 일치(50자 이하). 팀 정보는 싣지 않는다
    """
    adminPosts(
        filter: AdminPostFilter = ALL
        keyword: String
        "이전 페이지의 nextCursor"
        after: String
    ): AdminPostPage!
}

extend type Mutation {
    "글을 삭제한다 (관리자, 소프트 삭제). 이미 삭제된 글은 POST_DELETED, 없는 글은 NOT_FOUND. 관리자 행동 로그가 남는다"
    adminDeletePost(postId: ID!): Boolean!
    "댓글을 삭제한다 (관리자, 소프트 삭제). 없거나 이미 삭제된 댓글은 NOT_FOUND. 관리자 행동 로그가 남는다"
    adminDeleteComment(commentId: ID!): Boolean!
}

"글 + 댓글 / 글만 / 댓글만"
enum AdminPostFilter {
    ALL
    POSTS
    COMMENTS
}

enum AdminPostKind {
    POST
    COMMENT
}

"""
게시물 관리 한 행. 글이면 id와 postId가 같고 content는 null.
댓글이면 title에 글 제목, content에 댓글 내용(앞 100자)이 담기고 postId로 글 상세에 이동한다
"""
type AdminPostItem {
    kind: AdminPostKind!
    id: ID!
    postId: ID!
    title: String!
    content: String
    author: AdminMemberBrief!
    "작성 시각 (KST, ISO-8601)"
    createdAt: String!
}

type AdminPostPage {
    items: [AdminPostItem!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

# 로그인·회원 (기능명세서 1장). 다른 도메인 스키마는 `extend type Query`·`extend type Mutation`으로 잇는다

type Query {
    "내 계정 정보. 승인 대기·거절 계정도 호출할 수 있다"
    me: Me!
}

type Mutation {
    "GitHub 로그인 뒤 받은 일회용 코드를 액세스 토큰으로 바꾼다. 코드는 한 번만 쓸 수 있다"
    exchangeAuthCode(code: String!): AuthPayload!
}

enum MemberStatus {
    PENDING
    ACTIVE
    REJECTED
}

enum MemberRole {
    MEMBER
    ADMIN
}

type Me {
    id: ID!
    githubLogin: String!
    nickname: String!
    profileImageUrl: String
    status: MemberStatus!
    role: MemberRole!
}

type AuthPayload {
    accessToken: String!
    "액세스 토큰 유효 시간(초)"
    expiresIn: Int!
    me: Me!
}

# 면제 (기능명세서 7장, 관리자 9장 면제 관리). 면제 기간 관리와 개인 면제 승인·거절은 관리자,
# 개인 면제 요청은 그 팀의 팀장. 소급 면제는 재계산 미리보기(무변경)를 먼저 부른 뒤 확인하고 반영한다

extend type Query {
    "내가 보낸 개인 면제 요청 목록 (TM-08 ⑤). 최신순 커서 기반 20개"
    myPersonalExemptionRequests(
        "이전 페이지의 nextCursor"
        after: String
    ): PersonalExemptionPage!
    "면제 기간 목록 (관리자). 주차 최신순 커서 기반 20개"
    exemptionPeriods(
        "이전 페이지의 nextCursor"
        after: String
    ): ExemptionPeriodPage!
    """
    그 주를 면제 기간으로 등록하면 바뀌는 판정과 영향 미리보기 (관리자, E-45). 계산만 하고 아무것도 바꾸지 않는다.
    아직 판정되지 않은 주는 retroactive=false이고 items가 비어 있다. 월요일이 아니면 INVALID_INPUT
    """
    previewExemptionPeriod(weekStart: String!): RetroExemptionPreview!
    "개인 면제 요청 목록 (관리자). 기본은 대기 건. 상태별 최신순 커서 기반 20개"
    personalExemptionRequests(
        status: PersonalExemptionStatus = PENDING
        "이전 페이지의 nextCursor"
        after: String
    ): PersonalExemptionPage!
    """
    개인 면제를 승인하면 바뀌는 판정과 영향 미리보기 (관리자, E-45). 계산만 하고 아무것도 바꾸지 않는다.
    이미 처리된 요청은 ALREADY_HANDLED
    """
    previewPersonalExemptionApproval(id: ID!): RetroExemptionPreview!
}

extend type Mutation {
    """
    개인 면제를 요청한다 (그 팀의 팀장만, TM-08). memberId는 그 팀의 팀원이거나 팀장 본인.
    같은 회원·주간에 대기·승인 건이 있으면 EXEMPTION_REQUEST_DUPLICATE, 팀장이 아니면 FORBIDDEN.
    사유는 1~200자, weekStart는 월요일 yyyy-MM-dd
    """
    requestPersonalExemption(teamId: ID!, memberId: ID!, weekStart: String!, reason: String!): PersonalExemption!
    """
    면제 기간을 등록한다 (관리자). 이미 판정된 주면 그 주 통과·미달 판정이 면제로 바뀌고 경고가 다시 계산된다.
    같은 주가 있으면 EXEMPTION_PERIOD_DUPLICATE
    """
    createExemptionPeriod(input: ExemptionPeriodInput!): ExemptionPeriod!
    """
    면제 기간의 주차·사유를 고친다 (관리자). 다른 주로 옮기면 새 주에 소급 면제가 걸린다.
    이미 면제로 바뀐 판정은 되돌리지 않는다(확정 판정은 정정으로만 바뀐다)
    """
    updateExemptionPeriod(id: ID!, input: ExemptionPeriodInput!): ExemptionPeriod!
    "면제 기간을 지운다 (관리자). 이미 면제로 바뀐 판정은 되돌리지 않는다"
    deleteExemptionPeriod(id: ID!): Boolean!
    "개인 면제 요청을 승인한다 (관리자). 이미 판정된 주면 그 회원의 통과·미달이 면제로 바뀐다. 이미 처리된 요청은 ALREADY_HANDLED"
    approvePersonalExemption(id: ID!): PersonalExemption!
    "개인 면제 요청을 거절한다 (관리자). 사유 필수(1~500자, E-48)"
    rejectPersonalExemption(id: ID!, reason: String!): PersonalExemption!
}

enum PersonalExemptionStatus {
    PENDING
    APPROVED
    REJECTED
}

input ExemptionPeriodInput {
    "그 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "1~200자"
    reason: String!
}

type ExemptionPeriod {
    id: ID!
    "그 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "그 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    reason: String!
    createdAt: String!
    updatedAt: String
}

type ExemptionPeriodPage {
    items: [ExemptionPeriod!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

"개인 면제 요청 한 건. 팀 이름은 싣지 않는다"
type PersonalExemption {
    id: ID!
    "면제 대상"
    member: AdminMemberBrief!
    "요청한 팀장"
    requester: AdminMemberBrief!
    weekStart: String!
    weekEnd: String!
    status: PersonalExemptionStatus!
    reason: String!
    "거절됐을 때만 값이 있다"
    rejectReason: String
    respondedAt: String
    createdAt: String!
    "그 주가 이미 전체 면제 기간이다 (E-44). 두 면제는 독립으로 보존되고 따로 승인하지 않아도 판정에서 빠진다"
    overlapsExemptionPeriod: Boolean!
}

type PersonalExemptionPage {
    items: [PersonalExemption!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

"소급 면제 미리보기. retroactive=false면 아직 판정 전이라 바뀌는 판정이 없다"
type RetroExemptionPreview {
    weekStart: String!
    retroactive: Boolean!
    items: [RetroExemptionImpact!]!
}

type RetroExemptionImpact {
    member: AdminMemberBrief!
    "면제로 바뀌기 전 판정 (통과 또는 미달)"
    currentStatus: AdminJudgmentStatus!
    impact: AdminRecalcImpact!
}

# 내 주간 활동·판정 (기능명세서 5장, 화면설계서 CM-01 이번 주 진행·AC-01). 본인 것만 조회한다

extend type Query {
    """
    내 주간 활동. weekStart는 월요일 날짜(yyyy-MM-dd), 생략하면 이번 주, 미래 주는 INVALID_INPUT.
    잔디는 하루 한 번 새벽에 갱신한 캐시를 그대로 보여주고 이 쿼리가 GitHub를 부르지 않는다(grassFetchedAt이 갱신 기준 시각).
    기록글 수는 실시간이다. 판정이 끝난 주는 판정 시점에 저장한 값을 보여준다
    """
    myWeeklyActivity(weekStart: String): WeeklyActivity!
    "내 지난 판정 목록 (AC-01 ⑤). 최근 주부터 커서 기반 20개"
    myJudgmentHistory(
        "이전 페이지의 nextCursor"
        after: String
    ): JudgmentHistoryPage!
}

"판정 결과. HOLD는 GitHub 조회 실패로 아직 확정하지 못한 상태이고 진행 중인 주와 다르다"
enum JudgmentStatus {
    PASS
    FAIL
    EXEMPT
    EXCLUDED
    HOLD
}

"판정에서 빠진 이유. NO_TEAM·FIRST_WEEK은 제외, EXEMPTION_PERIOD·PERSONAL_EXEMPTION은 면제"
enum JudgmentSkipReason {
    NO_TEAM
    FIRST_WEEK
    EXEMPTION_PERIOD
    PERSONAL_EXEMPTION
}

"보류 이유. API_ERROR는 재시도로 풀리고 IDENTITY_MISMATCH는 본인이 다시 로그인해야 풀린다"
enum JudgmentHoldReason {
    API_ERROR
    IDENTITY_MISMATCH
}

"이번 주 화면 상단 배너 후보. 동시에 해당하면 위에서부터 하나만 내려온다"
enum ActivityBanner {
    "GitHub 비공개 기여 표시가 꺼진 듯함 (E-39)"
    CONTRIBUTIONS_HIDDEN
    "잔디를 아직 못 불러옴 (E-32)"
    GRASS_NOT_LOADED
    "계정 생애 첫 팀 참가 주 (E-36)"
    FIRST_WEEK
    "면제 주간 (E-46)"
    EXEMPTION_WEEK
}

type WeeklyActivity {
    "그 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "그 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    currentWeek: Boolean!
    "지금 소속된 팀이 있는가. 없으면 판정 대상이 아니다"
    inTeam: Boolean!
    "월~일 7행"
    days: [ActivityDay!]!
    "인증일 수. 잔디를 못 불러와 알 수 없으면 null"
    verifiedDays: Int
    recordCount: Int!
    requiredVerifiedDays: Int!
    requiredRecordCount: Int!
    "이번 주 통과 예정인가. 이번 주를 볼 때만 있고 인증일을 모르면 null"
    passExpected: Boolean
    "잔디 캐시가 있는가"
    grassAvailable: Boolean!
    "잔디 갱신 기준 시각 (KST, ISO-8601). 저장된 판정을 보여줄 때는 null"
    grassFetchedAt: String
    "이번 주를 볼 때 배너 하나. 없으면 null"
    banner: ActivityBanner
    "그 주의 판정 결과. 아직 판정 전이면 null"
    judgment: WeekJudgment
}

"날짜별 인증 한 행. null은 알 수 없음(안 불러왔거나 갱신 전이거나 저장하지 않은 값)"
type ActivityDay {
    date: String!
    hasGrass: Boolean
    "잔디 기여 수. 판정이 끝난 주는 저장하지 않아 null"
    grassCount: Int
    hasRecord: Boolean!
    "기록글 수. 판정이 끝난 주는 저장하지 않아 null"
    recordCount: Int
}

"한 주의 판정 결과. 제외·면제·보류 주는 인증일·기록글이 null"
type WeekJudgment {
    status: JudgmentStatus!
    skipReason: JudgmentSkipReason
    holdReason: JudgmentHoldReason
    verifiedDays: Int
    recordCount: Int
    "관리자 정정을 거쳤는가"
    corrected: Boolean!
    "확정 시각 (KST, ISO-8601)"
    judgedAt: String
}

type JudgmentHistoryItem {
    weekStart: String!
    weekEnd: String!
    status: JudgmentStatus!
    skipReason: JudgmentSkipReason
    holdReason: JudgmentHoldReason
    verifiedDays: Int
    recordCount: Int
    corrected: Boolean!
}

type JudgmentHistoryPage {
    items: [JudgmentHistoryItem!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

# 가입 승인 (기능명세서 1·9장)과 관리자 지정 (2026-10-29 사용자 지시), 관리자 전용

extend type Query {
    "가입 승인 탭 목록. 오래된 신청부터 커서 기반 20개"
    adminMembers(
        "기본은 승인 대기. ALL은 승인 대기와 거절"
        status: MemberApprovalFilter = PENDING
        "이름·GitHub 아이디 부분 일치 (50자 이하)"
        keyword: String
        "이전 페이지의 nextCursor"
        after: String
    ): AdminMemberPage!
}

extend type Mutation {
    "승인 대기 회원을 승인한다"
    approveMember(memberId: ID!): AdminMember!
    "승인 대기 회원을 거절한다. 관리자 행동 로그가 남는다"
    rejectMember(memberId: ID!): AdminMember!
    "거절된 회원을 승인 대기로 되돌린다"
    revertMemberToPending(memberId: ID!): AdminMember!
    "활성 일반 회원을 관리자로 지정한다. 승인 대기·거절 회원과 이미 관리자인 회원은 CONFLICT. 관리자 행동 로그가 남는다"
    promoteMemberToAdmin(memberId: ID!): AdminMember!
}

enum MemberApprovalFilter {
    PENDING
    REJECTED
    ALL
}

type AdminMember {
    id: ID!
    githubLogin: String!
    nickname: String!
    status: MemberStatus!
    role: MemberRole!
    "신청 시각 (KST, ISO-8601)"
    createdAt: String!
}

type AdminMemberPage {
    items: [AdminMember!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
    "현재 조건의 전체 건수"
    totalCount: Int!
}

# 공지 (기능명세서 4장). 조회는 전체 회원, 작성·수정·삭제·고정은 관리자. 댓글 없음

extend type Query {
    "공지 목록. 고정 공지가 위, 그 아래 최신순. 커서 기반 20개"
    notices(
        "이전 페이지의 nextCursor"
        after: String
    ): NoticePage!
    "공지 상세. 없는 공지는 NOT_FOUND"
    notice(id: ID!): Notice!
}

extend type Mutation {
    "공지를 작성한다 (관리자)"
    createNotice(input: NoticeInput!): Notice!
    "공지를 수정한다. isPinned를 생략하면 고정이 풀린다 (관리자)"
    updateNotice(id: ID!, input: NoticeInput!): Notice!
    "상단 고정을 켜고 끈다 (관리자)"
    setNoticePinned(id: ID!, isPinned: Boolean!): Notice!
    "공지를 삭제한다. 잔디 인정 규칙 공지(isSystem)는 SYSTEM_NOTICE_UNDELETABLE로 거부한다 (관리자)"
    deleteNotice(id: ID!): Boolean!
}

input NoticeInput {
    "1~200자"
    title: String!
    content: String!
    "상단 고정. 기본 false"
    isPinned: Boolean = false
}

type Notice {
    id: ID!
    title: String!
    content: String!
    isPinned: Boolean!
    "잔디 인정 규칙 공지. 삭제할 수 없다"
    isSystem: Boolean!
    "작성 시각 (KST, ISO-8601)"
    createdAt: String!
    "수정 시각 (KST, ISO-8601). 수정 전에는 null"
    updatedAt: String
}

type NoticePage {
    items: [Notice!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

# 게시판 (기능명세서 3장): 트러블슈팅·개발일지 글, 태그, 검색, 댓글. 모든 회원 호출 가능, 삭제는 작성자 본인만,
# 수정은 작성자 본인 또는 그 글이 연결된 팀의 현재 팀장(기능명세서 2장)

extend type Query {
    """
    게시판 목록. 최신순, 커서 기반 20개.
    tag는 정확히 일치하는 태그, q는 제목·내용·태그 검색(앞뒤 공백 제외 2~50자, 공백으로 나눈 단어를 모두 포함한 글).
    q·tag는 함께 쓰면 둘 다 만족하는 글만 나온다
    """
    posts(type: PostType!, tag: String, q: String, "이전 페이지의 nextCursor" after: String): PostPage!
    "글 상세. 없으면 NOT_FOUND, 삭제된 글은 POST_DELETED"
    post(id: ID!): Post!
    "태그 필터에 보여줄 많이 쓰인 태그 상위 10개. type을 생략하면 두 종류 전체"
    popularTags(type: PostType): [TagCount!]!
}

extend type Mutation {
    "글을 쓴다. 필수 항목을 모두 채우지 않아도 저장되지만 기록글로 인정되지 않는다(isRecord=false)"
    createPost(input: CreatePostInput!): Post!
    """
    글을 고친다 (작성자 본인 또는 그 글이 연결된 팀의 현재 팀장). 글 종류와 작성일은 바뀌지 않는다.
    팀장이 남의 글을 고칠 때는 teamId를 읽지 않고 기존 팀 연결을 유지한다. 그 밖의 사람은 FORBIDDEN
    """
    updatePost(id: ID!, input: UpdatePostInput!): Post!
    "글을 지운다 (작성자 본인만, 소프트 삭제). 팀장도 지울 수 없다"
    deletePost(id: ID!): Boolean!
    "댓글을 쓴다. 삭제된 글에는 달 수 없다 (1~500자)"
    createComment(postId: ID!, content: String!): Comment!
    "댓글을 고친다 (작성자 본인 또는 그 글이 연결된 팀의 현재 팀장)"
    updateComment(id: ID!, content: String!): Comment!
    "댓글을 지운다 (작성자 본인만, 소프트 삭제). 팀장도 지울 수 없다"
    deleteComment(id: ID!): Boolean!
}

enum PostType {
    TROUBLESHOOTING
    DEVLOG
}

"종류별 본문 항목. 트러블슈팅은 problem·cause·solution, 개발일지는 did·learned만 값이 있다"
type PostSections {
    problem: String
    cause: String
    solution: String
    did: String
    learned: String
}

type Post {
    id: ID!
    "작성자 회원 id. 본인 글 여부(수정·삭제 버튼) 판단에 쓴다"
    authorId: ID!
    author: BoardAuthor!
    "연결된 팀 id. 없으면 null. 팀 이름은 teamName(team.graphqls에서 확장, 비공개 팀은 숨김)"
    teamId: ID
    type: PostType!
    title: String!
    sections: PostSections!
    "정규화된 태그(앞뒤 공백 제거, 소문자). 글당 최대 5개"
    tags: [String!]!
    commitUrls: [String!]!
    "필수 항목을 모두 채웠는가. false면 '인증 미포함' 배지 (E-25)"
    isRecord: Boolean!
    "최초 저장일(KST, yyyy-MM-dd). 수정해도 바뀌지 않는다"
    writtenDate: String!
    "작성 시각 (KST, ISO-8601)"
    createdAt: String!
    "수정 시각 (KST, ISO-8601). 수정 전에는 createdAt과 같다"
    updatedAt: String!
    commentCount: Int!
    "댓글 목록. 오래된 순, 커서 기반 20개. 대댓글 없음"
    comments("이전 페이지의 nextCursor" after: String): CommentPage!
}

type Comment {
    id: ID!
    postId: ID!
    authorId: ID!
    author: BoardAuthor!
    content: String!
    createdAt: String!
    updatedAt: String!
}

type CommentPage {
    items: [Comment!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

type BoardAuthor {
    id: ID!
    nickname: String!
    profileImageUrl: String
}

type PostPage {
    items: [Post!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
    "현재 조건(종류·태그·검색어)의 전체 글 수. 요청했을 때만 센다"
    totalCount: Int!
}

type TagCount {
    tag: String!
    count: Int!
}

input PostSectionsInput {
    problem: String
    cause: String
    solution: String
    did: String
    learned: String
}

input CreatePostInput {
    type: PostType!
    "1~60자"
    title: String!
    "글 종류에 해당하는 항목만 쓰이고 나머지는 무시된다"
    sections: PostSectionsInput!
    "최대 5개, 개당 20자"
    tags: [String!]
    "https://github.com/{owner}/{repo}/commit/{sha} 형식만 허용. 실제 존재 여부는 확인하지 않는다"
    commitUrls: [String!]
    "연결할 팀 id (선택). 지금 내가 소속인 삭제되지 않은 팀만 가능하고, 아니면 POST_TEAM_INVALID"
    teamId: ID
}

"모든 값을 통째로 바꾼다. 생략한 tags·commitUrls·teamId는 비워진다. 팀장이 남의 글을 고칠 때 teamId는 무시된다"
input UpdatePostInput {
    title: String!
    sections: PostSectionsInput!
    tags: [String!]
    commitUrls: [String!]
    teamId: ID
}

# 프로필 주간 판정 이력 (화면설계서 PR-01 ⑩, 기능명세서 5·8장). 본인 · 타인이 같은 모양이고 팀 이름은 싣지 않는다

extend type Profile {
    """
    주간 판정 이력 (PR-01 ⑩). 최근 주부터 커서 기반 20개 (E-57).
    첫 페이지 맨 위에는 이번 주 IN_PROGRESS 행이 하나 더 붙는다(판정 대상 주이고 아직 판정 전일 때만, 20개에 세지 않는다).
    팀이 없던 주(제외 · NO_TEAM)는 나오지 않고 첫 참가 주와 면제 주는 나온다. 판정 기록이 없으면 빈 목록이다 (팀 미소속 · 첫 주, EX-PR01-03)
    """
    judgmentHistory(
        "이전 페이지의 nextCursor"
        after: String
    ): ProfileJudgmentPage!
}

"""
판정 이력의 결과 (PR-01 ⑩). PASS 통과 / FAIL 미달(경고) / EXEMPT 면제 / EXCLUDED 제외 / IN_PROGRESS 진행 중.
이번 주와 아직 확정되지 않은 보류 주가 IN_PROGRESS로 나온다
"""
enum ProfileJudgmentResult {
    PASS
    FAIL
    EXEMPT
    EXCLUDED
    IN_PROGRESS
}

"판정 이력 한 행. 면제·제외 주와 보류 주는 인증일·기록글이 null이다 (AC-01 ⑤ '—')"
type ProfileJudgmentWeek {
    "그 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "그 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    result: ProfileJudgmentResult!
    "인증일 수. 진행 중인 이번 주는 잔디 캐시가 없으면 null"
    verifiedDays: Int
    recordCount: Int
}

type ProfileJudgmentPage {
    items: [ProfileJudgmentWeek!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

# 프로필 팀별 경고 (화면설계서 PR-01 ⑨, 기능명세서 8장, Q-13 확정). 본인 · 타인이 같은 모양이다

extend type Profile {
    """
    팀별 경고 (PR-01 ⑨). 경고 1개에 팀이 여러 개 붙으므로 중복 집계이고, 줄마다 센 값을 더한 합계는 누적 경고 수와 다를 수 있다.
    ⑧ 경고 합계와 같은 기준으로 센다: 현재 경고 수에 들어가는 경고만 세고 이행 완료·차감된 경고는 뺀다.
    경고가 없으면 빈 목록이고, 판정 보류가 남아 있으면 계산하지 않아 onHold만 true다
    """
    teamWarnings: ProfileTeamWarnings!
}

type ProfileTeamWarnings {
    onHold: Boolean!
    "공개 팀(이름순) → 비공개 팀 → 삭제된 팀 순"
    teams: [ProfileTeamWarning!]!
}

"{팀 이름} {count}회. 비공개 팀은 '비공개 팀', 삭제된 팀은 '삭제된 팀'으로 나오고 열람자를 구분하지 않는다. 비공개·삭제된 팀은 여러 팀이어도 한 줄이다"
type ProfileTeamWarning {
    name: String!
    count: Int!
}

# 프로필 조회 (기능명세서 8장, 화면설계서 PR-01).
# 사진 변경(S3 업로드)은 보류 중이라 없고, 팀별 경고(PR-01 ⑨)는 profile-warning.graphqls, 주간 판정 이력(⑩)은 profile-history.graphqls에서 확장한다

extend type Query {
    "프로필 (승인된 회원 누구나, 본인 · 타인 같은 모양). 없는 회원이나 승인되지 않은 회원은 NOT_FOUND"
    profile(memberId: ID!): Profile!
}

type Profile {
    id: ID!
    "GitHub 계정 이름. 수정할 수 없다"
    nickname: String!
    githubLogin: String!
    "S3 주소. null이면 기본 이미지"
    profileImageUrl: String
    "내 프로필인가 (프로필 수정 · 관리자 메뉴 버튼 노출 판단)"
    isMine: Boolean!
    "삭제되지 않은 글 수 (MongoDB 집계)"
    postCount: Int!
    "삭제되지 않은 댓글 수 (MongoDB 집계)"
    commentCount: Int!
    "GitHub 잔디. 캐시가 없으면 null (E-32). 하루 한 번 갱신한 캐시이고 이 쿼리가 GitHub를 부르지 않는다"
    grass: ProfileGrass
    "경고 합계 카드 (n / 3)"
    warning: ProfileWarning!
    "소속 팀. 공개 팀만 나오고 비공개 팀은 빠진다"
    teams: [ProfileTeam!]!
}

type ProfileGrass {
    "캐시가 덮는 첫 날 (yyyy-MM-dd)"
    from: String!
    "캐시가 덮는 마지막 날 (yyyy-MM-dd)"
    to: String!
    "갱신 기준 시각 (KST, ISO-8601). '오늘 오전 6시 기준'에 쓴다"
    fetchedAt: String!
    "날짜 오름차순, 날짜마다 기여 수 (0이면 잔디 없음)"
    days: [ProfileGrassDay!]!
}

type ProfileGrassDay {
    date: String!
    count: Int!
}

"저장된 카운트가 아니라 판정 이력을 처음부터 다시 훑어 계산한 값. 보류 주가 남아 있으면 onHold만 true이고 나머지는 null"
type ProfileWarning {
    onHold: Boolean!
    "벌칙 이행 이후 살아 있고 차감되지 않은 경고 수. 3을 넘을 수 있다"
    warningCount: Int
    "경고 3개 이상이면 벌칙 대상 (E-40)"
    penaltyTarget: Boolean
}

type ProfileTeam {
    id: ID!
    name: String!
}

# 팀 현황판 (기능명세서 2장 팀 현황판, 화면설계서 TM-05)와 내 팀 목록의 이번 주 요약 (TM-01 ⑧).
# 이번 주(월~일, KST) 값만 다룬다. 잔디는 하루 한 번 새벽에 갱신한 캐시를 그대로 보여주고 GitHub를 부르지 않는다

extend type Query {
    """
    팀 현황판 (TM-05). 그 팀의 현재 팀원·팀장과 시스템 관리자만 볼 수 있다 (그 밖의 비소속 FORBIDDEN, 없거나 삭제된 팀은 관리자도 NOT_FOUND).
    인증일·잔디는 새벽 갱신 시점 값(grassFetchedAt이 기준 시각)이고, 기록글 수·경고 수는 조회할 때 읽는다.
    잔디를 못 불러온 팀원은 인증일이 null이고 나머지 값은 그대로 내려온다
    """
    teamBoard(teamId: ID!): TeamBoard!
}

extend type Team {
    "이번 주 요약 (TM-01 ⑧). 내 팀 목록에서 팀마다 불러도 쿼리가 팀 수만큼 늘지 않는다. 팀 조회가 허용된 시스템 관리자에게도 열린다"
    weekSummary: TeamWeekSummary!
}

"팀 현황판 상태 칸. 미달은 주가 끝나고 판정이 확정된 뒤에만 나온다"
enum TeamBoardStatus {
    "인증일 3일 이상 그리고 기록글 1개 이상을 이미 채움"
    PASS
    "아직 못 채웠지만 주가 진행 중이라 만회할 수 있음"
    NOT_YET
    "판정이 미달로 확정됨"
    FAIL
    "판정 제외·면제 주 (첫 참가 주·면제 주간)"
    EXCLUDED
}

type TeamBoard {
    "이번 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "이번 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    "잔디 갱신 기준 시각 (KST, ISO-8601). 잔디 캐시가 있는 팀원 중 가장 오래된 시각이고, 하나도 없으면 null"
    grassFetchedAt: String
    "잔디를 못 불러온 팀원이 있는가 (E-32 배너)"
    grassNotLoaded: Boolean!
    "팀장이 맨 앞, 나머지는 참가한 순서"
    members: [TeamBoardMember!]!
    "이 팀에 연결된 글 최신 5건. 필수 항목이 빈 글도 포함한다(isRecord로 구분)"
    recentPosts: [TeamBoardPost!]!
}

type TeamBoardMember {
    memberId: ID!
    nickname: String!
    githubLogin: String!
    "내 행인가"
    isMe: Boolean!
    "월~일 7행"
    days: [TeamBoardDay!]!
    "인증일 수 (잔디 또는 기록글이 있는 날, 같은 날 둘 다여도 1일). 잔디를 못 불러와 알 수 없으면 null"
    verifiedDays: Int
    "이번 주 기록글 수. 팀 연결과 무관한 개인 기준"
    recordCount: Int!
    "이 팀 카테고리가 붙은 지금 경고 수. 차감된 경고·벌칙 이행 이전 경고는 세지 않고, 다른 팀 경고와 벌칙 대상 여부는 담지 않는다. 판정 보류가 남아 알 수 없으면 null"
    warningCount: Int
    status: TeamBoardStatus!
}

"날짜별 한 칸. null은 알 수 없음(잔디를 못 불러왔거나 캐시 구간 밖)"
type TeamBoardDay {
    date: String!
    hasGrass: Boolean
    hasRecord: Boolean!
    "인증일인가 (잔디 또는 기록글). 둘 다 없는데 잔디를 모르면 null"
    verified: Boolean
}

"이 팀에 연결된 글 한 줄 (말머리·제목·작성자·날짜)"
type TeamBoardPost {
    id: ID!
    type: PostType!
    title: String!
    author: BoardAuthor!
    "작성 시각 (KST, ISO-8601)"
    createdAt: String!
    "필수 항목을 모두 채운 기록글인가. false면 인증 미포함 글"
    isRecord: Boolean!
}

"이번 주 요약. 판정 제외·면제인 팀원은 어느 쪽에도 세지 않는다"
type TeamWeekSummary {
    "이번 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    passCount: Int!
    "판정이 미달로 확정된 인원. 주가 끝나기 전에는 0"
    failCount: Int!
    "아직 못 채웠지만 주가 진행 중인 인원"
    notYetCount: Int!
}

# 팀 글 관리 (기능명세서 2장, TM-06 ⑧): 팀에 연결된 글·댓글 목록. 그 팀의 팀장만 호출할 수 있고 관리자도 예외 없다
# (비소속·비팀장 FORBIDDEN, 없는/삭제된 팀 NOT_FOUND). 삭제된 글·댓글은 나오지 않는다. 수정은 updatePost·updateComment를 쓴다

extend type Query {
    "팀에 연결된 글 목록 (TM-06 ⑧). 팀장만. 최신순, 커서 기반 20개"
    teamPosts(teamId: ID!, "이전 페이지의 nextCursor" after: String): TeamPostPage!
    "팀에 연결된 글에 달린 댓글 목록 (TM-06 ⑧). 팀장만. 최신순, 커서 기반 20개. 댓글이 달린 글은 postId로 안다"
    teamComments(teamId: ID!, "이전 페이지의 nextCursor" after: String): TeamCommentPage!
}

type TeamPostPage {
    items: [Post!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

type TeamCommentPage {
    items: [Comment!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

# 팀 (기능명세서 2장): 생성·참가·아이디 초대·추방·탈퇴·위임·삭제·공개 설정. ACTIVE 회원만 호출할 수 있고,
# 팀장 전용·팀원 전용은 팀을 읽어서 검사한다(비소속·비팀장 FORBIDDEN, 없는/삭제된 팀 NOT_FOUND).
# 시스템 관리자(ADMIN)는 team·teamMembers·teamInviteCode·sentTeamInvitations·updateTeam·inviteToTeam·cancelTeamInvitation·
# kickTeamMember·transferTeamLeadership·deleteTeam을 소속과 상관없이 모든 팀에 쓸 수 있다. 관리자도 없는/삭제된 팀은 NOT_FOUND.
# 참가·초대 수락·거절·자진 탈퇴·내 팀 목록에는 관리자 예외가 없다

extend type Query {
    "내 팀 목록 (TM-01). 참가한 순서(오래된 순). TM-01이 페이지 대신 계속 쌓는 목록이라 커서 없이 전부 준다. 비공개 팀도 본인에게는 실제 이름"
    myTeams: [Team!]!
    "팀 기본 정보. 그 팀의 팀원·팀장과 시스템 관리자만 볼 수 있다. 팀원이 아닌 시스템 관리자의 joinedAt은 null"
    team(id: ID!): Team!
    "팀원 목록 (TM-06). 그 팀의 팀원·팀장과 시스템 관리자만. 팀장이 맨 앞, 나머지는 참가한 순서. 커서 기반 20개"
    teamMembers(teamId: ID!, "이전 페이지의 nextCursor" after: String): TeamMemberPage!
    "초대코드 다시 확인 (TM-06). 그 팀의 팀장과 시스템 관리자만. 코드는 생성할 때 한 번 정해지고 재발급은 없다"
    teamInviteCode(teamId: ID!): String!
    "받은 초대 목록 (TM-04). 최신순, 커서 기반 20개. 비공개 팀이어도 초대받은 당사자에게는 실제 팀 이름"
    receivedTeamInvitations("이전 페이지의 nextCursor" after: String): ReceivedTeamInvitationPage!
    "보낸 초대 중 대기 중인 목록 (TM-06). 그 팀의 팀장과 시스템 관리자만. 최신순, 커서 기반 20개"
    sentTeamInvitations(teamId: ID!, "이전 페이지의 nextCursor" after: String): SentTeamInvitationPage!
}

extend type Mutation {
    "팀을 만든다. 만든 사람이 팀장이고, 초대코드가 이때 한 번 발급된다 (TM-02)"
    createTeam(input: CreateTeamInput!): CreateTeamPayload!
    "팀의 공개·비공개를 바꾼다 (팀장과 시스템 관리자만, TM-06 ⑦). 이름·소개 수정은 제공하지 않는다"
    updateTeam(teamId: ID!, input: UpdateTeamInput!): Team!
    """
    초대코드로 참가한다 (TM-03). 대소문자 구분 없음.
    없는 코드 TEAM_CODE_NOT_FOUND, 이미 참가 TEAM_ALREADY_JOINED, 추방 후 1년 차단 TEAM_JOIN_BLOCKED(남은 기간은 알려주지 않는다)
    """
    joinTeamByCode(code: String!): Team!
    """
    GitHub 아이디로 초대한다 (팀장과 시스템 관리자만, TM-06). 가입한(승인된) 회원만 찾는다.
    없는 아이디 INVITEE_NOT_FOUND, 이미 팀원 INVITEE_ALREADY_MEMBER, 대기 중인 초대가 이미 있으면 INVITATION_DUPLICATE.
    추방한 사람도 초대할 수 있다 (초대코드 차단과 무관)
    """
    inviteToTeam(teamId: ID!, githubLogin: String!): SentTeamInvitation!
    "보낸 초대를 철회한다 (팀장과 시스템 관리자만). 대기 중인 초대만"
    cancelTeamInvitation(invitationId: ID!): Boolean!
    """
    받은 초대를 수락해 바로 참가한다 (TM-04).
    이미 다른 경로로 참가했으면 INVITATION_ALREADY_JOINED, 팀이 없어졌으면 TEAM_GONE (둘 다 초대는 정리된다).
    추방됐던 팀으로 돌아오면 그 팀 경고 카테고리가 복원된다
    """
    acceptTeamInvitation(invitationId: ID!): Team!
    "받은 초대를 거절한다"
    declineTeamInvitation(invitationId: ID!): Boolean!
    "팀원을 추방한다 (팀장과 시스템 관리자만). 그 팀 경고 카테고리가 빠지고, 이 팀 초대코드로는 1년간 재참가할 수 없다. 팀장은 누가 시켜도 추방할 수 없다(위임 후 추방)"
    kickTeamMember(teamId: ID!, memberId: ID!): Boolean!
    """
    팀에서 나간다 (자진 탈퇴, 경고는 유지). 팀장은 나갈 수 없다:
    넘길 팀원이 있으면 LEADER_MUST_TRANSFER, 혼자면 LEADER_LAST_MEMBER(팀 삭제만 가능)
    """
    leaveTeam(teamId: ID!): Boolean!
    "팀장을 다른 팀원에게 넘긴다 (팀장과 시스템 관리자만). 새 팀장은 현재 팀원이어야 하고, 되돌릴 수 없다"
    transferTeamLeadership(teamId: ID!, newLeaderId: ID!): Team!
    "팀을 삭제한다 (팀장과 시스템 관리자만). 글은 남고 팀 연결만 끊기며, 팀 경고 카테고리가 빠진다"
    deleteTeam(teamId: ID!): Boolean!
}

extend type Post {
    "연결된 팀 이름. 비공개 팀·삭제된 팀·연결 없는 글은 null (열람자와 무관, E-23)"
    teamName: String
}

type Team {
    id: ID!
    name: String!
    description: String
    isPublic: Boolean!
    leader: TeamPerson!
    "내가 이 팀의 팀장인가"
    isLeader: Boolean!
    memberCount: Int!
    "내가 이 팀에 참가한 시각 (KST, ISO-8601). 팀원이 아닌 시스템 관리자는 null"
    joinedAt: String
    createdAt: String!
}

"이름만 보여주는 회원 정보"
type TeamPerson {
    id: ID!
    nickname: String!
    githubLogin: String!
    profileImageUrl: String
}

type TeamMember {
    id: ID!
    nickname: String!
    githubLogin: String!
    profileImageUrl: String
    isLeader: Boolean!
    "이 팀에 참가한 시각 (KST, ISO-8601)"
    joinedAt: String!
}

type ReceivedTeamInvitation {
    id: ID!
    teamId: ID!
    teamName: String!
    "초대한 팀장"
    inviter: TeamPerson!
    createdAt: String!
}

type SentTeamInvitation {
    id: ID!
    invitee: TeamPerson!
    createdAt: String!
}

type TeamMemberPage {
    items: [TeamMember!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

type ReceivedTeamInvitationPage {
    items: [ReceivedTeamInvitation!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

type SentTeamInvitationPage {
    items: [SentTeamInvitation!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

"팀 생성 결과. 초대코드는 이때 한 번 보여준다. 이후에는 팀장이 teamInviteCode로 다시 확인한다"
type CreateTeamPayload {
    team: Team!
    inviteCode: String!
}

input CreateTeamInput {
    "1~20자"
    name: String!
    "100자 이내 (선택)"
    description: String
    "생략하면 공개"
    isPublic: Boolean
}

input UpdateTeamInput {
    isPublic: Boolean!
}

# 내 경고 이력 표 (화면설계서 AC-02 ③, 기능명세서 6장, Q-13 확정). 본인 것만 조회한다

extend type Query {
    """
    내 경고 이력. 최근 주부터 커서 기반 20개 (E-57).
    경고 수를 저장하지 않고 판정 이력을 처음부터 다시 훑은 결과로 상태를 정한다.
    삭제 표시된 경고와 정정·소급 면제로 미달이 아니게 된 주의 경고는 나오지 않는다.
    판정 보류가 남아 있으면 상태를 정할 수 없어 onHold만 true이고 items는 비어 있다
    """
    myWarningHistory(
        "이전 페이지의 nextCursor"
        after: String
    ): WarningHistoryPage!
}

"경고 이력의 상태 (Q-13)"
enum WarningHistoryStatus {
    "벌칙 이행 이후 살아 있고 차감되지 않아 현재 경고 수에 들어간다 (유효)"
    ACTIVE
    "2주 연속 통과로 차감됐다 (차감됨)"
    DEDUCTED
    "벌칙 이행 체크 이전에 받았다. 기록만 남고 현재 경고 수에는 넣지 않는다 (이행 완료)"
    FULFILLED
}

"경고 이력 표 한 행"
type WarningHistoryItem {
    "경고를 받은 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "그 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    "사유: 인증일 수. 알 수 없으면 null"
    verifiedDays: Int
    "사유: 기록글 수. 알 수 없으면 null"
    recordCount: Int
    "팀 카테고리 표시 이름. 공개 팀은 이름, 비공개 팀은 '비공개 팀', 삭제된 팀은 '삭제된 팀'. 열람자를 구분하지 않는다"
    categories: [String!]!
    status: WarningHistoryStatus!
}

type WarningHistoryPage {
    "판정 보류가 남아 있어 계산을 미룬 상태"
    onHold: Boolean!
    items: [WarningHistoryItem!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

# 내 경고 요약 (기능명세서 6장, 화면설계서 CM-01 ④·AC-02 ①②). 경고 이력 표는 Q-13 결정 뒤에 잇는다

extend type Query {
    """
    내 경고 요약. 저장된 카운트가 아니라 판정 이력을 처음부터 다시 훑어 계산한 값이다.
    판정 보류가 남아 있으면 계산을 미뤄 onHold만 true이고 숫자는 null이다
    """
    myWarningSummary: WarningSummary!
}

type WarningSummary {
    onHold: Boolean!
    "보류 중인 주차 월요일 목록 (yyyy-MM-dd)"
    holdWeeks: [String!]!
    "벌칙 이행 이후 살아 있고 차감되지 않은 경고 수. 3을 넘을 수 있다"
    warningCount: Int
    "지금 연속 통과 수. 2가 되면 경고 1개를 차감하고 0으로 돌아간다. 벌칙 대상이면 쌓지 않아 0"
    streak: Int
    "경고 3개 이상이면 벌칙 대상. 이 상태에서는 연속 통과해도 차감되지 않는다"
    penaltyTarget: Boolean
    "경고가 3개에 도달한 주 월요일 (yyyy-MM-dd). 벌칙 대상일 때만"
    penaltyReachedWeek: String
}

